KITE_API_KEY=
KITE_API_SECRET=
# Web (apps/web) — copy into apps/web/.env.local
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_USE_MOCKS=true
# Prefer Next.js callback for the web UI:
KITE_REDIRECT_URL=http://localhost:3000/auth/callback
# API-only smoke alternative: http://127.0.0.1:8000/auth/callback
# Optional: defaults to <repo-root>/data/portfolio.db (absolute sqlite URL if set)
# DATABASE_URL=sqlite:////absolute/path/to/data/portfolio.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
